# Segredos e configuración local. Os exemplos non conterán valores reais.
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key

# Dependencias e contornos locais; conservar manifests e lockfiles.
node_modules/
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# Saídas xeradas. Revisar as convencións específicas de cada tecnoloxía.
/proyecto/bin/
/proyecto/**/build/
/proyecto/**/dist/
/proyecto/**/target/
**/bin/
**/obj/
.gradle/
*.class
*.jar
*.war
*.exe
*.dll
*.so
*.dylib
*.o
*.a

# Datos locais de execución e rexistros, non sementes ficticias.
/proyecto/datos/local/
/proyecto/logs/
/proyecto/coverage/
*.log

# Ficheiros do editor e do sistema.
.DS_Store
*~
*.swp
